@tasks.loop(minutes=5)
async def cleanup_task() -> None:
    now = time.time()
    for g in store.guilds.values():
        expired = [uid for uid, t in g.punished.items() if t < now]
        for uid in expired:
            del g.punished[uid]
    store.save()


