def is_trusted(member: discord.Member, gdata: GuildData) -> bool:
    if member.id in gdata.whitelist or member.guild_permissions.administrator:
        return True
    return any(r.id in gdata.trusted_roles for r in member.roles)


async def send_log(guild: discord.Guild, embed: discord.Embed) -> None:
    """Carl-style log sender"""
    gdata = store.get_guild(guild.id)
    ch_id = gdata.config.get("log_channel_id")
    if not ch_id:
        return
    channel = guild.get_channel(ch_id)
    if isinstance(channel, discord.TextChannel):
        try:
            await channel.send(embed=embed)
        except Exception:
            pass


async def punish(member: discord.Member, reason: str, duration: int = 3600) -> None:
    gdata = store.get_guild(member.guild.id)
    gdata.punished[member.id] = time.time() + duration
    store.save()
    try:
        await member.timeout(discord.utils.utcnow() + discord.timedelta(seconds=duration), reason=reason)
        action = f"Timed out ({duration // 60}m)"
    except Exception:
        try:
            await member.kick(reason=reason)
            action = "Kicked"
        except Exception:
            action = "Failed"
    embed = discord.Embed(
        title="🛡️ Security Action",
        description=f"**User:** {member.mention} (`{member.id}`)\n**Action:** {action}\n**Reason:** {reason}",
        color=0xFF4444,
        timestamp=datetime.now(timezone.utc),
    )
    await send_log(member.guild, embed)


