@tree.command(name="pay", description="Pay pesos to another user")
@app_commands.describe(member="User to pay", amount="Amount")
async def pay(interaction: discord.Interaction, member: discord.Member, amount: int) -> None:
    if member.bot or member.id == interaction.user.id or amount <= 0:
        await interaction.response.send_message("❌ Invalid", ephemeral=True)
        return
    eco = store.get_user(interaction.user.id)
    if eco.cash < amount:
        await interaction.response.send_message("❌ Not enough pesos", ephemeral=True)
        return
    store.get_user(member.id).cash += amount
    eco.cash -= amount
    store.save()
    await interaction.response.send_message(embed=discord.Embed(title="💸 Payment Sent", description=f"You sent **{amount:,} ₱** to {member.mention}", color=0x57F287))


@tree.command(name="slots", description="3D Slots")
@app_commands.describe(bet="Bet amount")
async def slots(interaction: discord.Interaction, bet: int) -> None:
    eco = store.get_user(interaction.user.id)
    if bet <= 0 or bet > eco.cash:
        await interaction.response.send_message("❌ Invalid bet", ephemeral=True)
        return
    eco.cash -= bet
    symbols = ["🍒", "🍋", "🔔", "⭐", "💎", "7️⃣", "🪙"]
    result = [random.choice(symbols) for _ in range(3)]
    display = f"╔══════════╗\n║  {result[0]} │ {result[1]} │ {result[2]}  ║\n╚══════════╝"
    if result[0] == result[1] == result[2]:
        mult = 12 if result[0] in ("💎", "7️⃣") else 6
        win = bet * mult
        eco.cash += win
        msg, color = f"🎉 **JACKPOT!** +{win:,} ₱", 0xFEE75C
    elif len(set(result)) < 3:
        win = bet * 2
        eco.cash += win
        msg, color = f"✨ You won **{win:,} ₱**", 0x57F287
    else:
        msg, color = "💨 No match...", 0xED4245
    store.save()
    embed = discord.Embed(title="🎰 3D SLOTS", description=f"```\n{display}\n```\n{msg}", color=color)
    embed.set_footer(text=f"Bet: {bet:,} ₱  •  Balance: {eco.cash:,} ₱")
    await interaction.response.send_message(embed=embed)


@tree.command(name="coinflip", description="Coin flip")
@app_commands.describe(bet="Bet amount", choice="heads or tails")
@app_commands.choices(choice=[
    app_commands.Choice(name="🟡 Heads", value="heads"),
    app_commands.Choice(name="⚪ Tails", value="tails"),
])
async def coinflip(interaction: discord.Interaction, bet: int, choice: app_commands.Choice[str]) -> None:
    eco = store.get_user(interaction.user.id)
