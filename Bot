    if now - eco.daily_claimed < 86400:
        remaining = int(86400 - (now - eco.daily_claimed))
        await interaction.response.send_message(f"⏳ Come back in **{remaining // 3600}h {(remaining % 3600) // 60}m**", ephemeral=True)
