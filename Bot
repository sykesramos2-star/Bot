@tree.command(name="verify", description="Verify a member")
@app_commands.default_permissions(manage_roles=True)
async def verify(interaction: discord.Interaction, member: discord.Member) -> None:
    gdata = store.get_guild(interaction.guild_id)
    if q_id := gdata.config.get("quarantine_role_id"):
        if role := interaction.guild.get_role(q_id):
            if role in member.roles:
                await member.remove_roles(role, reason="Verified")
    if v_id := gdata.config.get("verified_role_id"):
        if role := interaction.guild.get_role(v_id):
            await member.add_roles(role, reason="Verified")
    await interaction.response.send_message(f"✅ {member.mention} verified")


