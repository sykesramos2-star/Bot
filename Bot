class GuildData:
    def __init__(self, guild_id: int) -> None:
        self.guild_id = guild_id
        self.config: Dict[str, Any] = DEFAULTS.copy()
        self.whitelist: Set[int] = set()
        self.trusted_roles: Set[int] = set()
        self.punished: Dict[int, float] = {}
        self.join_times: Deque[float] = deque()
        self.ban_times: Deque[float] = deque()
        self.kick_times: Deque[float] = deque()
        self.channel_deletes: Deque[float] = deque()
        self.role_deletes: Deque[float] = deque()

    def to_dict(self) -> Dict[str, Any]:
        return {
            "config": self.config,
            "whitelist": list(self.whitelist),
            "trusted_roles": list(self.trusted_roles),
            "punished": self.punished,
        }

    @classmethod
    def from_dict(cls, guild_id: int, data: Dict[str, Any]) -> "GuildData":
        g = cls(guild_id)
        g.config.update(data.get("config", {}))
        g.whitelist = set(data.get("whitelist", []))
        g.trusted_roles = set(data.get("trusted_roles", []))
        g.punished = {int(k): float(v) for k, v in data.get("punished", {}).items()}
        return g


class UserEconomy:
    def __init__(self) -> None:
        self.cash: int = START_CASH
        self.bank: int = 0
        self.daily_claimed: float = 0.0
        self.work_claimed: float = 0.0

    def to_dict(self) -> Dict[str, Any]:
        return {
            "cash": self.cash,
            "bank": self.bank,
            "daily_claimed": self.daily_claimed,
            "work_claimed": self.work_claimed,
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "UserEconomy":
        u = cls()
        u.cash = int(data.get("cash", START_CASH))
        u.bank = int(data.get("bank", 0))
        u.daily_claimed = float(data.get("daily_claimed", 0))
        u.work_claimed = float(data.get("work_claimed", 0))
        return u


class DataStore:
    def __init__(self, path: Path) -> None:
        self.path = path
        self.guilds: Dict[int, GuildData] = {}
        self.economy: Dict[int, UserEconomy] = {}
        self._load()

    def _load(self) -> None:
        if not self.path.exists():
            return
        try:
            raw = json.loads(self.path.read_text(encoding="utf-8"))
            for gid, gdata in raw.get("guilds", {}).items():
                self.guilds[int(gid)] = GuildData.from_dict(int(gid), gdata)
            for uid, edata in raw.get("economy", {}).items():
                self.economy[int(uid)] = UserEconomy.from_dict(edata)
        except Exception as e:
            log.error("Load failed: %s", e)

    def save(self) -> None:
        try:
            payload = {
                "guilds": {str(k): v.to_dict() for k, v in self.guilds.items()},
                "economy": {str(k): v.to_dict() for k, v in self.economy.items()},
            }
            self.path.write_text(json.dumps(payload, indent=2), encoding="utf-8")
        except Exception as e:
            log.error("Save failed: %s", e)

    def get_guild(self, guild_id: int) -> GuildData:
        if guild_id not in self.guilds:
            self.guilds[guild_id] = GuildData(guild_id)
        return self.guilds[guild_id]

    def get_user(self, user_id: int) -> UserEconomy:
        if user_id not in self.economy:
            self.economy[user_id] = UserEconomy()
        return self.economy[user_id]


