    store.save()
    embed = discord.Embed(title="🪙 Coin Flip", description=msg, color=color)
    embed.set_footer(text=f"Balance: {eco.cash:,} ₱")
    await interaction.response.send_message(embed=embed)


@tree.command(name="scatter", description="High-risk 3D Scatter")
@app_commands.describe(bet="Amount to risk")
async def scatter(interaction: discord.Interaction, bet: int) -> None:
    eco = store.get_user(interaction.user.id)
    if bet <= 0 or bet > eco.cash:
        await interaction.response.send_message("❌ Invalid bet", ephemeral=True)
        return
    eco.cash -= bet
    roll = random.random()
    if roll < 0.52:
        mult, msg, color = 0, "💨 The scatter vanished...", 0xED4245
    elif roll < 0.78:
        mult, msg, color = 1.8, "✨ Soft scatter hit!", 0x57F287
    elif roll < 0.93:
        mult, msg, color = 3.5, "🔥 Strong scatter!", 0xFEE75C
    else:
        mult, msg, color = 12, "💥 **MEGA 3D SCATTER!**", 0xEB459E
    win = int(bet * mult)
    eco.cash += win
    store.save()
    embed = discord.Embed(
        title="🌀 3D SCATTER",
        description=f"{msg}\n\n**Bet** → `{bet:,} ₱`\n**Multiplier** → `x{mult}`\n**Won** → `{win:,} ₱`\n**Balance** → `{eco.cash:,} ₱`",
        color=color,
    )
    await interaction.response.send_message(embed=embed)


