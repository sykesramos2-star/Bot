@bot.event
async def on_member_join(member: discord.Member) -> None:
    # Carl-style join log
    embed = discord.Embed(
        title="📥 Member Joined",
        color=0x57F287,
        timestamp=datetime.now(timezone.utc),
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(name="User", value=f"{member.mention} (`{member.id}`)", inline=False)
    embed.add_field(name="Account Created", value=discord.utils.format_dt(member.created_at, "R"), inline=True)
    embed.add_field(name="Member Count", value=str(member.guild.member_count), inline=True)
    await send_log(member.guild, embed)

    if member.bot:
        return

    gdata = store.get_guild(member.guild.id)
    now = time.time()
    while gdata.join_times and now - gdata.join_times[0] > gdata.config["join_window"]:
        gdata.join_times.popleft()
    gdata.join_times.append(now)

    if len(gdata.join_times) >= gdata.config["join_threshold"]:
        raid_embed = discord.Embed(
            title="🚨 RAID DETECTED",
            description=f"**{len(gdata.join_times)}** joins in {gdata.config['join_window']}s\nLatest: {member.mention}",
            color=0xFF0000,
            timestamp=datetime.now(timezone.utc),
        )
        await send_log(member.guild, raid_embed)
        if q_id := gdata.config.get("quarantine_role_id"):
            if role := member.guild.get_role(q_id):
                try:
                    await member.add_roles(role, reason="Raid quarantine")
                except Exception:
                    pass

    if gdata.config.get("verification_enabled"):
        if q_id := gdata.config.get("quarantine_role_id"):
            if role := member.guild.get_role(q_id):
                try:
                    await member.add_roles(role, reason="Awaiting verification")
                except Exception:
                    pass


@bot.event
async def on_member_remove(member: discord.Member) -> None:
    embed = discord.Embed(
        title="📤 Member Left",
        color=0xED4245,
        timestamp=datetime.now(timezone.utc),
    )
    embed.set_thumbnail(url=member.display_avatar.url)
    embed.add_field(name="User", value=f"{member} (`{member.id}`)", inline=False)
    roles = [r.mention for r in member.roles if r != member.guild.default_role]
    if roles:
        embed.add_field(name="Roles", value=" ".join(roles[:15]), inline=False)
    embed.add_field(name="Member Count", value=str(member.guild.member_count), inline=True)
    await send_log(member.guild, embed)

    # Kick detection
    await asyncio.sleep(1)
    gdata = store.get_guild(member.guild.id)
    now = time.time()
    try:
        async for entry in member.guild.audit_logs(action=discord.AuditLogAction.kick, limit=3):
            if entry.target and entry.target.id == member.id and isinstance(entry.user, discord.Member):
                while gdata.kick_times and now - gdata.kick_times[0] > gdata.config["kick_window"]:
                    gdata.kick_times.popleft()
                gdata.kick_times.append(now)

                kick_embed = discord.Embed(
                    title="👢 Member Kicked",
                    color=0xFEE75C,
                    timestamp=datetime.now(timezone.utc),
                )
                kick_embed.add_field(name="User", value=f"{member} (`{member.id}`)")
                kick_embed.add_field(name="Moderator", value=entry.user.mention)
                kick_embed.add_field(name="Reason", value=entry.reason or "No reason", inline=False)
                await send_log(member.guild, kick_embed)

                if len(gdata.kick_times) >= gdata.config["kick_threshold"] and not is_trusted(entry.user, gdata):
                    await punish(entry.user, f"Mass kick ({len(gdata.kick_times)})", 7200)
                break
    except Exception:
        pass


