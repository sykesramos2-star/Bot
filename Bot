@tree.command(name="config", description="View/change thresholds")
@app_commands.default_permissions(administrator=True)
async def config_cmd(interaction: discord.Interaction, key: Optional[str] = None, value: Optional[int] = None) -> None:
    gdata = store.get_guild(interaction.guild_id)
    if key is None:
        lines = [f"**{k}**: `{v}`" for k, v in gdata.config.items() if not str(k).endswith("_id")]
        await interaction.response.send_message(embed=discord.Embed(title="Config", description="\n".join(lines), color=0x2B2D31))
        return
    valid = {"join_threshold", "join_window", "ban_threshold", "ban_window", "kick_threshold", "kick_window", "channel_delete_threshold", "role_delete_threshold"}
    if key.lower() not in valid:
        await interaction.response.send_message(f"Valid: {', '.join(sorted(valid))}", ephemeral=True)
        return
    if value is None:
        await interaction.response.send_message(f"`{key}` = `{gdata.config.get(key)}`")
        return
    gdata.config[key.lower()] = value
    store.save()
    await interaction.response.send_message(f"✅ `{key}` → `{value}`")


